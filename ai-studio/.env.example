# AI_API_KEY: Optional server-side credential for the configured AI model service.
# Users may instead save a personal key in the browser from “AI 服务与隐私设置”.
AI_API_KEY="MY_AI_API_KEY"

# Backward-compatible fallback for deployments that still use this variable.
GEMINI_API_KEY=""

# APP_URL: Public URL of the deployed application.
APP_URL="MY_APP_URL"
